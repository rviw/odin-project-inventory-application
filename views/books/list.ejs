<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
  </head>
  <body>
    <%- include("../partials/header") %>

    <main class="container">
      <section class="hero">
        <h2>Books</h2>
        <p>Browse all books in the inventory.</p>
        <p><a class="button" href="/books/new">Add book</a></p>
      </section>

      <% if (books.length === 0) { %>
        <p>No books found.</p>
      <% } else { %>
        <section class="card-grid">
          <% books.forEach((book) => { %>
            <article class="card">
              <h3>
                <a href="/books/<%= book.id %>"><%= book.title %></a>
              </h3>
              <p>Author: <%= book.author_name %></p>
              <p>Category: <%= book.category_name %></p>
              <p>Stock: <%= book.stock_quantity %></p>
            </article>
          <% }) %>
        </section>
      <% } %>
    </main>

    <%- include("../partials/footer") %>
  </body>
</html>