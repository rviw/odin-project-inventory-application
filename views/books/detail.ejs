<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
  </head>
  <body>
    <%- include("../partials/header") %>

    <main class="container">
      <section class="hero">
        <p class="back-link"><a href="/books">← Back</a></p>
        <h2><%= book.title %></h2>
        <p><%= book.description %></p>

        <div class="action-row">
          <a class="button" href="/books/<%= book.id %>/edit">Edit</a>

          <form
            class="protected-action-form"
            action="/books/<%= book.id %>/delete"
            method="post"
          >
            <input name="admin_password" type="hidden" />
            <button
              class="button button-danger"
              type="submit"
            >
              Delete
            </button>
          </form>
        </div>
      </section>

      <%- include("../partials/errors", {
        errors: deleteError ? [{ msg: deleteError }] : [],
      }) %>

      <section class="card-grid">
        <article class="card">
          <h3>Details</h3>
          <p>
            Author:
            <a href="/authors/<%= book.author_id %>"><%= book.author_name %></a>
          </p>
          <p>
            Category:
            <a href="/categories/<%= book.category_id %>"
              ><%= book.category_name %></a
            >
          </p>
          <p>ISBN: <%= book.isbn %></p>
          <p>Price: $<%= Number(book.price).toFixed(2) %></p>
          <p>Stock: <%= book.stock_quantity %></p>
        </article>
      </section>
    </main>

    <%- include("../partials/footer") %>
  </body>
</html>
