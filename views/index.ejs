<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
  </head>
  <body>
    <%- include("partials/header") %>

    <main class="container">
      <section class="hero">
        <h2>Welcome</h2>
        <p>Manage categories, authors, and books in one place.</p>
      </section>

      <section class="card-grid">
          <article class="card">
            <h3><a href="/categories">Categories</a></h3>
            <p><%= counts.category_count %> categories</p>
          </article>

          <article class="card">
            <h3><a href="/authors">Authors</a></h3>
            <p><%= counts.author_count %> authors</p>
          </article>

          <article class="card">
            <h3><a href="/books">Books</a></h3>
            <p><%= counts.book_count %> books</p>
          </article>
      </section>

      <section class="low-stock">
        <h3>Low stock</h3>

        <% if (lowStockBooks.length === 0) { %>
          <p>No low-stock titles.</p>
        <% } else { %>
          <ul>
            <% lowStockBooks.forEach((book) => { %>
              <li>
                <strong><%= book.title %></strong>
                by <%= book.author_name %>
                - <%= book.stock_quantity %> left
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    </main>

    <%- include("partials/footer") %>
  </body>
</html>
