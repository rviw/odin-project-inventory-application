<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
  </head>
  <body>
    <%- include("../partials/header") %>

    <main class="container">
      <section class="hero">
        <p class="back-link"><a href="/categories">← Back</a></p>
        <h2><%= category.name %></h2>
        <p><%= books.length %> books in this category.</p>

        <div class="action-row">
          <a class="button" href="/categories/<%= category.id %>/edit">Edit</a>

          <form
            class="protected-action-form"
            action="/categories/<%= category.id %>/delete"
            method="post"
          >
            <input name="admin_password" type="hidden" />
            <button
              class="button button-danger"
              type="submit"
            >
              Delete
            </button>
          </form>
        </div>
      </section>

      <%- include("../partials/errors", {
        errors: deleteError ? [{ msg: deleteError }] : [],
      }) %>

      <% if (books.length !== 0) { %>
        <section class="card-grid">
          <% books.forEach((book) => { %>
            <article class="card">
              <h3>
                <a href="/books/<%= book.id %>"><%= book.title %></a>
              </h3>
              <p>
                Author:
                <a href="/authors/<%= book.author_id %>"><%= book.author_name %></a>
              </p>
              <p>ISBN: <%= book.isbn %></p>
              <p>Stock: <%= book.stock_quantity %></p>
            </article>
          <% }) %>
        </section>
      <% } %>
    </main>

    <%- include("../partials/footer") %>
  </body>
</html>
