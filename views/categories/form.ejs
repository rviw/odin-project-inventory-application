<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
  </head>
  <body>
    <%- include("../partials/header") %>

    <main class="container">
      <section class="hero">
        <p class="back-link"><a href="/categories">← Back</a></p>
        <h2><%= formTitle %></h2>
      </section>

      <%- include("../partials/errors", { errors }) %>

      <section class="card">
        <form
          class="form-stack protected-action-form"
          action="<%= formAction %>"
          method="post"
        >
          <input name="admin_password" type="hidden" />
          <div class="form-row">
            <label for="name">Category name</label>
            <input
              id="name"
              name="name"
              type="text"
              value="<%= category.name || "" %>"
              required
            />
          </div>

          <button class="button" type="submit"><%= submitLabel %></button>
        </form>
      </section>
    </main>

    <%- include("../partials/footer") %>
  </body>
</html>
