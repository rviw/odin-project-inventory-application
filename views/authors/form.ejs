<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
  </head>
  <body>
    <%- include("../partials/header") %>

    <main class="container">
      <section class="hero">
        <p class="back-link"><a href="/authors">← Back</a></p>
        <h2><%= formTitle %></h2>
      </section>

      <%- include("../partials/errors", { errors }) %>

      <section class="card">
        <form class="form-stack" action="<%= formAction %>" method="post">
          <div class="form-row">
            <label for="name">Author name</label>
            <input
              id="name"
              name="name"
              type="text"
              value="<%= author.name || "" %>"
              required
            />
          </div>

          <button class="button" type="submit"><%= submitLabel %></button>
        </form>
      </section>
    </main>

    <%- include("../partials/footer") %>
  </body>
</html>