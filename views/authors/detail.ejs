<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
  </head>
  <body>
    <%- include("../partials/header") %>

    <main class="container">
      <section class="hero">
        <p class="back-link"><a href="/authors">← Back</a></p>
        <h2><%= author.name %></h2>
        <p><%= books.length %> books by this author.</p>
      </section>

      <% if (books.length === 0) { %>
        <p>No books by this author yet.</p>
      <% } else { %>
        <section class="card-grid">
          <% books.forEach((book) => { %>
            <article class="card">
              <h3><%= book.title %></h3>
              <p>Category: <%= book.category_name %></p>
              <p>ISBN: <%= book.isbn %></p>
              <p>Stock: <%= book.stock_quantity %></p>
            </article>
          <% }) %>
        </section>
      <% } %>
    </main>

    <%- include("../partials/footer") %>
  </body>
</html>