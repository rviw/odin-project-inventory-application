<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
  </head>
  <body>
    <%- include("../partials/header") %>

    <main class="container">
      <section class="hero">
        <p class="back-link"><a href="/authors">← Back</a></p>
        <h2><%= author.name %></h2>
        <p><%= books.length %> books by this author.</p>

        <div class="action-row">
          <a class="button" href="/authors/<%= author.id %>/edit">Edit</a>

          <form
            class="protected-action-form"
            action="/authors/<%= author.id %>/delete"
            method="post"
          >
            <input name="admin_password" type="hidden" />
            <button
              class="button button-danger"
              type="submit"
            >
              Delete
            </button>
          </form>
        </div>
      </section>

      <%- include("../partials/errors", {
        errors: deleteError ? [{ msg: deleteError }] : [],
      }) %>

      <% if (books.length !== 0) { %>
        <section class="card-grid">
          <% books.forEach((book) => { %>
            <article class="card">
              <h3>
                <a href="/books/<%= book.id %>"><%= book.title %></a>
              </h3>
              <p>
                Category:
                <a href="/categories/<%= book.category_id %>"><%= book.category_name %></a>
              </p>
              <p>ISBN: <%= book.isbn %></p>
              <p>Stock: <%= book.stock_quantity %></p>
            </article>
          <% }) %>
        </section>
      <% } %>
    </main>

    <%- include("../partials/footer") %>
  </body>
</html>
